# Data Engine Environment Variables

ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=emotionlens
POSTGRES_USER=emotionlens
POSTGRES_PASSWORD=postgres 

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=emotionlens_raw

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Platform API keys (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=emotion-lens-crawler/1.0
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=

# Label Studio
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=

# Anti-ban
PROXY_URL=
PROXY_ROTATION_ENABLED=false

# Crawler tuning
MAX_CONCURRENT_REQUESTS=20
DEFAULT_RATE_LIMIT_RPM=30
PLAYWRIGHT_HEADLESS=true

# Dataset
DATASET_OUTPUT_DIR=./data/datasets
DATASET_VERSION=v1
