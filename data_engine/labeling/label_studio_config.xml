<!--
  Emotion Lens — Label Studio interface
  QUAN TRỌNG: Tạo project MỚI hoặc xóa annotation cũ (schema "sentiment")
  trước khi dán XML này, nếu không sẽ báo Validation error.

  Import data: chạy jsonl_to_labelstudio.py → Import JSON vào project.
-->
<View>
  <Header value="Emotion Lens — gán nhãn cảm xúc (VI/EN social text)"/>
  <Text name="text" value="$text"/>  <Choices name="emotion" toName="text" choice="single" showInline="true">
    <Choice value="joy"/>
    <Choice value="anger"/>
    <Choice value="sadness"/>
    <Choice value="anxiety"/>
    <Choice value="fear"/>
    <Choice value="surprise"/>
    <Choice value="admiration"/>
    <Choice value="love"/>
    <Choice value="neutral"/>
    <Choice value="sarcastic"/>
    <Choice value="toxic"/>
  </Choices>
  <Number name="toxicity" toName="text" min="0" max="1" step="0.1"/>
  <Number name="sarcasm" toName="text" min="0" max="1" step="0.1"/>
</View>
